import { useCartContext } from "../hooks/useCard";
import { Typography, Box, Button, IconButton } from "@mui/material";
import ShoppingCartIcon from '@mui/icons-material/ShoppingCart';
import { Remove as RemoveIcon, Add as AddIcon, Delete } from '@mui/icons-material'

const CartGrid = () => {
  const { cart, clearCart, removeFromCart, updateQuantity, totalItemAdded } = useCartContext();

  return (
    <>
      <Box sx={{ display: "flex", flexDirection: "column", height: "100%" }}>

        {/* Start Header with Clear Items Button Section*/}
        <Box sx={{ px: 5, py: 3 }}>
          <Box sx={{ display: "flex", alignItems: "center", justifyContent: "space-between" }}>
            <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
              <ShoppingCartIcon color="primary" fontSize="large" />
              <Typography variant="h4" fontWeight="bold">
                Detail Items
              </Typography>
            </Box>
            {cart.length > 0 && (
              <Button size="medium" color="error" variant="contained" onClick={clearCart} sx={{ fontWeight: "bold" }}>
                Clear All
              </Button>)}
          </Box>
        </Box>
        {/* Ended Header with Clear Items Button Section*/}

        {/* Start Added Items Section */}
        <Box sx={{ flex: 1, p: 5, overflow: 'auto' }}>
          {cart.length === 0 ? (
            <Box sx={{
              display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", height: "100%", py: 5
            }}>
              <ShoppingCartIcon sx={{ fontSize: 120, color: "text.disabled", mb: 1 }} />
              <Typography color="text.secondary" sx={{ fontSize: "1.5rem" }}>No items in cart</Typography>
            </Box>
          ) : (
            <Box sx={{ display: "flex", flexDirection: "column", gap: 2, justifyContent: "center" }}>
              {cart.map((item, index) => (
                <Box
                  key={`${item.id}-${index}`}
                  variant="outlined"
                  sx={{
                    "& .MuiCardContent-root": { bgcolor: "transparent" },
                    boxShadow: 3,
                    borderRadius: "0.5rem"
                  }}>

                  <Box sx={{ justifyContent: "space-between" }} >
                    {/* RightSide Added Items Section */}
                    <Box sx={{ display: "flex", alignItems: "center", bgcolor: "yellow", px: 3 }}>
                      <Box sx={{ display: "flex", flex: 1, flexDirection: "column" }}>
                        <Typography variant="subtitle1" sx={{ fontWeight: "bold", fontSize: "1.5rem", bgcolor: "red" }}>
                          {item.name}
                        </Typography>
                        <Box sx={{ display: "flex", alignItems: "center", gap: 1.5, bgcolor: "blue" }}>
                          <Box sx={{ display: "flex", alignItems: "center", gap: 3 }}>
                            <IconButton
                              size="medium"
                              onClick={() => updateQuantity(item.id, item.quantity - 1)}
                              border="1px solid #e0e0e0"
                              sx={{
                                width: "2.25rem",
                                height: "2.25rem",
                                borderRadius: "0.75rem",
                                boxShadow: 2,
                                "&:hover": {
                                  bgcolor: "#e0e0e0"
                                },
                              }}>
                              <RemoveIcon sx={{ color: "#ff6347", fontSize: 18 }} />
                            </IconButton>
                            <Typography variant="body2" sx={{ fontSize: "1.25rem", minWidth: 20, textAlign: "center" }}>
                              {item.quantity}
                            </Typography>
                            <IconButton
                              size="medium"
                              onClick={() => updateQuantity(item.id, item.quantity + 1)}
                              sx={{
                                width: "2.25rem",
                                height: "2.25rem",
                                borderRadius: "0.75rem",
                                boxShadow: 2,
                                backgroundColor: "#fee0d6",
                                "&:hover": {
                                  bgcolor: "#e98162"
                                },
                              }}>
                              <AddIcon />
                            </IconButton>
                          </Box>
                        </Box>
                      </Box>
                      {/* RightSide Added Items Section */}

                      <Box sx={{ display: "flex", alignItems: "flex-end" }}>
                        <Box sx={{ display: "flex", flex: 1, flexDirection: "column" }}>
                          <IconButton
                            size="medium"
                            color="error"
                            onClick={() => removeFromCart(item.id)}
                            sx={{
                              p: 1,
                              width: "3rem",
                              height: "3rem",
                            }}
                          >
                            <Delete fontSize="large" />
                          </IconButton>
                          <Typography
                            variant="subtitle1"
                            component="span"
                            color="textPrimary"
                            letterSpacing="0.5"
                            sx={{ fontSize: "1.5rem" }}>
                            ${item.price}
                          </Typography>
                        </Box>
                      </Box>

                    </Box>
                  </Box>
                </Box>
              ))}
            </Box>
          )}
        </Box>
        {/* End Added Items Section */}

        {/* Start Calculate Items Price Section */}
        {cart.length > 0 && (
          <Box sx={{ display: "flex", flexDirection: "column", bgcolor: "grey.500", gap: 2, p: 2 }}>
            <Box sx={{ display: "flex", flexDirection: "column", gap: 1, bgcolor: "grey.300" }}>

              <Box sx={{ display: "flex", justifyContent: "space-between" }}>
                <Typography variant="h5" color="text.secondary">Item</Typography>
                <Typography variant="h5">{totalItemAdded} items</Typography>
              </Box>

              <Box sx={{ display: "flex", justifyContent: "space-between" }}>
                <Typography variant="h5" color="text.secondary">Subtotal</Typography>
                <Typography variant="h5">$100</Typography>
              </Box>

            </Box>
          </Box>
        )}

      </Box >
    </>
  )
}

export default CartGrid;
